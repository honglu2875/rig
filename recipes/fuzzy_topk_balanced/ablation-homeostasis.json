    "hard_bias_report": "G * mean_group sum_choice((stop_gradient(hard_load) - 1/G)^2), with straight-through bias gradient G * (hard_load - 1/G)",
    "token_margin_alive": "mean_token_group(relu(margin - max_choice(score))^2)",
    "frequency_floor_alive": "G * mean_group sum_choice(relu(alive_target/G - stop_gradient(positive_route_frequency))^2), with its straight-through gradient applied only to the existing UP bias",
    "normalization": "Choice statistics and alive loss are reduced over the complete global data-parallel batch; the selected layer losses are averaged across transformer blocks before applying coefficients."
  },
