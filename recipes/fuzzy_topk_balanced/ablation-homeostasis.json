  "status": "mature_frequency_floor_selected_waiting_250m_gate",
  "objective": "Reduce late fuzzy Top-K feature death with training-only balance objectives while preserving the exact parent forward model and matched-active-FLOP ladder coordinates.",
  "prior_evidence": {
    "source_study": "fuzzy-topk-sparsity-diagnostics-ladder",
    "finding": "Late zero activation is mostly whole-group ReLU death, with an additional within-group winner-concentration effect.",
    "mean_final_trailing_dead_fraction": {
      "60m": 0.34330610275151513,
      "125m": 0.35761422983939395,
      "250m": 0.3386662356904762,
      "500m": 0.36337381979166666
    }
  },
  "hypotheses": {
    "choice_balance": "A population-level balance loss across the four choices in every fixed group prevents persistent winner monopolies without preventing token specialization.",
    "group_survival": "A squared hinge on negative group maxima directly prevents the larger failure mode in which all four features fall below ReLU.",
    "frequency_floor": "A global-batch floor on each feature's positive routing frequency can prevent death while remaining dormant above a declared aggregate group-activity target, avoiding the density pressure of a per-token hinge.",
    "combination": "Choice balance and group survival address separable mechanisms and may compose better than either alone.",
    "quality": "A treatment can retain the parent fuzzy validation advantage while materially reducing late dead-feature fractions."
  },
