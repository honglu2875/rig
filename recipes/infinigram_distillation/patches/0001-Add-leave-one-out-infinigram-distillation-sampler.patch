+                                  U64 *tc) const override {
+        _e.infgram_loo_sample_batch(
+            static_cast<const T *>(contexts), static_cast<const T *>(targets), rows, cols,
+            max_len, has_reset, static_cast<T>(reset_token), seed, static_cast<T *>(samples),
