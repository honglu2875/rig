+    // Draw one exact next-token sample from the infinite-gram distribution at
+    // every position, after removing one occurrence of the observed
+    // continuation.  This is the leave-one-occurrence-out teacher needed when
+    // the queried sequence itself belongs to the indexed corpus: without the
+    // subtraction, a unique context simply retrieves its own next token.
+    //
+    // `contexts[row, t]` is the final token visible to the model and
+    // `targets[row, t]` is the continuation to exclude.  When `has_reset` is
+    // true, matching context never extends to the left of the most recent
+    // reset token, but the reset token itself remains visible (BOS semantics).
+    // Returned counts are after the subtraction.  If the observed
+    // continuation does not occur, nothing is subtracted; this keeps the
+    // primitive useful for sequences not contained in the index as well.
+    void infgram_loo_sample_batch(const T *contexts, const T *targets, U64 rows, U64 cols,
+                                  U64 max_len, bool has_reset, T reset_token, U64 seed,
+                                  T *samples, U32 *suffix_lens, U64 *prompt_cnts,
+                                  U64 *target_cnts) const {
+        const size_t S = _shards.size();
+        struct Segment {
+            U64 row;
+            U64 begin;
+            U64 end;
+        };
+        std::vector<Segment> segments;
+        segments.reserve(rows * (has_reset ? 16 : 1));
+        for (U64 row = 0; row < rows; row++) {
+            const T *seq = contexts + row * cols;
+            U64 begin = 0;
+            if (has_reset) {
+                for (U64 t = 1; t < cols; t++) {
+                    if (seq[t] != reset_token) continue;
+                    segments.push_back(Segment{row, begin, t});
+                    begin = t;
+                }
+            }
+            if (begin < cols) segments.push_back(Segment{row, begin, cols});
+        }
+
+        // Documents are independent once reset semantics are enabled, so use
+        // them as the parallel work unit.  An 8k FineWeb batch has dozens of
+        // documents but only a handful of rows; row-level parallelism alone
+        // would leave most CPU cores idle.
+        _pool.parallel_for(0, segments.size(), [&](U64 task) {
+            const Segment seg = segments[task];
+            const U64 row = seg.row;
+            const T *seq = contexts + row * cols;
+            const T *truth = targets + row * cols;
+            RangeBuf ranges(S);
+            auto &ext = extension_scratch<T>();
+            U64 prev = 0;
+
+            for (U64 t = seg.begin; t < seg.end; t++) {
+                U64 cap = t - seg.begin + 1;
+                if (max_len > 0 && cap > max_len) cap = max_len;
+                U64 l = prev + 1;
+                if (l > cap) l = cap;
+
+                U64 available = 0;
+                U64 observed = 0;
+                U64 excluded = 0;
+                for (;;) {
+                    const T *pat = seq + t + 1 - l;
+                    find(pat, l, nullptr, ranges.data());
+                    available = successor_total(l, ranges.data());
+
+                    ext.assign(pat, pat + l);
+                    ext.push_back(truth[t]);
+                    observed = 0;
+                    for (size_t s = 0; s < S; s++) {
+                        observed += _shards[s]->find(ext.data(), l + 1, ranges[s]).size();
+                    }
+                    excluded = observed > 0 ? 1 : 0;
+                    if (available > excluded) break;
+                    if (l == 0) throw Error("cannot sample from an empty leave-one-out corpus");
+                    l--;
+                }
+
+                U64 state = seed ^ (0x9e3779b97f4a7c15ULL * (row * cols + t + 1));
+                T sampled;
+                for (;;) {
+                    U64 draw = splitmix64(state) % available;
+                    sampled = sample_successor(l, ranges.data(), draw);
+                    if (!excluded || sampled != truth[t]) break;
+                    // All `observed` matching continuations are exchangeable.
+                    // Reject one of them with probability 1/observed, which is
+                    // exactly equivalent to deleting the current occurrence.
+                    if (splitmix64(state) % observed != 0) break;
+                }
+
+                U64 idx = row * cols + t;
+                samples[idx] = sampled;
+                suffix_lens[idx] = static_cast<U32>(l);
+                prompt_cnts[idx] = available - excluded;
+                target_cnts[idx] = observed - excluded;
+                prev = l;
+            }
+        });
+    }
+
     // Next-token distribution at every position of every row, returned as a
     // ragged (CSR-style) structure.  `infinite` selects between a fixed context
     // window and the longest matching suffix.
@@ -319,6 +418,45 @@ class Engine {
     }
 
   private:
+    static U64 splitmix64(U64 &state) {
+        U64 z = (state += 0x9e3779b97f4a7c15ULL);
+        z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+        z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+        return z ^ (z >> 31);
+    }
+
+    // Number of occurrences in `ranges` that have a continuation.  For a
+    // non-empty pattern, at most one occurrence per shard is flush against the
+    // shard tail, and it is the first rank among equal suffixes.
+    U64 successor_total(U64 len, const Range *ranges) const {
+        U64 out = 0;
+        for (size_t s = 0; s < _shards.size(); s++) {
+            Range r = ranges[s];
+            if (r.empty()) continue;
+            T tok;
+            if (!_shards[s]->next_token(r.lo, len, &tok)) r.lo++;
+            out += r.size();
+        }
+        return out;
+    }
+
+    // Map a global rank among valid continuation occurrences back to its token.
+    T sample_successor(U64 len, const Range *ranges, U64 draw) const {
+        for (size_t s = 0; s < _shards.size(); s++) {
+            Range r = ranges[s];
+            if (r.empty()) continue;
+            T tok;
+            if (!_shards[s]->next_token(r.lo, len, &tok)) r.lo++;
+            if (draw < r.size()) {
+                if (!_shards[s]->next_token(r.lo + draw, len, &tok))
+                    throw Error("invalid continuation rank");
+                return tok;
+            }
+            draw -= r.size();
+        }
+        throw Error("continuation sample out of range");
+    }
+
     // Walk the rank range, splitting until both ends agree on the next token.
     // Cost is O(distinct * log range) probes.  Iterative on purpose: the
     // reference implementation spawns a thread per recursion node, which
