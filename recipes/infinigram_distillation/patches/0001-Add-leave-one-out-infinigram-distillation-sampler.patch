+    def infgram_loo_sample_batch(
+        self,
+        contexts: np.ndarray,
+        targets: np.ndarray,
+        *,
+        seed: int = 0,
+        max_len: int = 0,
+        reset_token: Optional[int] = None,
+    ):
+        """Sample an exact leave-one-occurrence-out teacher target per token.
+
+        This is intended for distillation on the indexed corpus itself.  One
+        occurrence of each observed continuation is removed, and the query
+        backs off until at least one other continuation remains.  Sampling one
+        target is an unbiased Monte Carlo estimator of cross-entropy against
+        the resulting sparse next-token distribution.
+
+        ``contexts[:, t]`` is visible when predicting ``targets[:, t]``.  If
+        ``reset_token`` is supplied, context cannot extend left of its latest
+        occurrence, while the reset token itself remains visible.
+        """
+        x = np.ascontiguousarray(contexts, dtype=self.dtype)
+        y = np.ascontiguousarray(targets, dtype=self.dtype)
+        return self._engine.infgram_loo_sample_batch(
+            x, y, seed, max_len, reset_token
+        )
+
