+def _loo_oracle(tokens, context, target, max_len=0):
+    context = [int(x) for x in context]
+    upper = len(context) if not max_len else min(len(context), max_len)
+    corpus = [int(x) for x in tokens]
+    for length in range(upper, -1, -1):
+        suffix = context[-length:] if length else []
+        counts = {}
+        for start in range(len(corpus) - length):
+            if corpus[start : start + length] != suffix:
+                continue
+            continuation = corpus[start + length]
+            counts[continuation] = counts.get(continuation, 0) + 1
+        if counts.get(int(target), 0):
+            counts[int(target)] -= 1
+            if counts[int(target)] == 0:
+                del counts[int(target)]
+        if counts:
+            return length, counts
+    raise AssertionError("non-empty corpus must yield a leave-one-out distribution")
+
+
+@pytest.mark.parametrize("max_len", [0, 3])
+def test_infgram_loo_samples_match_brute_force(
+    small_index, small_corpus, max_len
+):
+    # Start immediately before a document marker so the batch exercises both
+    # the previous document's EOT prediction and reset-token-as-BOS semantics.
+    marker = int(np.flatnonzero(small_corpus[100:] == 999)[0] + 100)
+    starts = [marker - 8, marker + 37]
+    x = np.stack([small_corpus[s : s + 64] for s in starts])
+    y = np.stack([small_corpus[s + 1 : s + 65] for s in starts])
+
+    got, slens, prompt_counts, target_counts = (
+        small_index.infgram_loo_sample_batch(
+            x, y, seed=12345, max_len=max_len, reset_token=999
+        )
+    )
+    again = small_index.infgram_loo_sample_batch(
+        x, y, seed=12345, max_len=max_len, reset_token=999
+    )[0]
+    assert np.array_equal(got, again)
+
+    for row in range(x.shape[0]):
+        segment_start = 0
+        for t in range(x.shape[1]):
+            if int(x[row, t]) == 999:
+                segment_start = t
+            context = x[row, segment_start : t + 1]
+            length, counts = _loo_oracle(
+                small_corpus, context, int(y[row, t]), max_len=max_len
+            )
+            assert int(slens[row, t]) == length
+            assert int(prompt_counts[row, t]) == sum(counts.values())
+            assert int(target_counts[row, t]) == counts.get(int(y[row, t]), 0)
+            assert int(got[row, t]) in counts
+
+
+def test_infgram_loo_sampling_frequencies_match_adjusted_distribution(
+    small_index, small_oracle
+):
+    context_token = 3
+    raw = small_oracle.ntd([context_token])
+    observed = max(raw, key=raw.get)
+    expected = dict(raw)
+    expected[observed] -= 1
+    if expected[observed] == 0:
+        del expected[observed]
+    total = sum(expected.values())
+
+    rows = 20_000
+    x = np.full((rows, 1), context_token, dtype=np.uint16)
+    y = np.full((rows, 1), observed, dtype=np.uint16)
+    samples, slens, prompt_counts, target_counts = (
+        small_index.infgram_loo_sample_batch(x, y, seed=991)
+    )
+
+    assert np.all(slens == 1)
+    assert np.all(prompt_counts == total)
+    assert np.all(target_counts == expected.get(observed, 0))
+    values, counts = np.unique(samples, return_counts=True)
+    empirical = {int(v): int(c) / rows for v, c in zip(values, counts)}
+    assert set(empirical) == set(expected)
+    for token, count in expected.items():
+        assert empirical[token] == pytest.approx(count / total, abs=0.015)
+
