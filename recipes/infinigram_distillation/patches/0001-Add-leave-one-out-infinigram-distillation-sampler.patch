+    def infgram_loo_sample_batch(self, contexts, targets, uint64_t seed=0,
+                                 uint64_t max_len=0, reset_token=None):
+        """Sample exact leave-one-occurrence-out infinite-gram targets.
+
+        ``contexts`` and ``targets`` are equally shaped 2-D arrays.  At each
+        position, one occurrence of the observed target is removed before the
+        teacher sample is drawn.  Returns ``(samples, suffix_lens,
+        prompt_counts, target_counts)``; counts are after subtraction.
+        """
+        cdef cnp.ndarray x = np.ascontiguousarray(contexts, dtype=self.dtype)
+        cdef cnp.ndarray y = np.ascontiguousarray(targets, dtype=self.dtype)
+        if x.ndim != 2 or y.ndim != 2 or x.shape[0] != y.shape[0] or x.shape[1] != y.shape[1]:
+            raise ValueError("contexts and targets must be equally shaped 2-D arrays")
+        cdef uint64_t rows = x.shape[0]
+        cdef uint64_t cols = x.shape[1]
+        samples = np.empty((rows, cols), dtype=self.dtype)
+        slens = np.zeros((rows, cols), dtype=np.uint32)
+        pc = np.zeros((rows, cols), dtype=np.uint64)
+        tc = np.zeros((rows, cols), dtype=np.uint64)
+        cdef uint32_t[:, ::1] sl_v = slens
+        cdef uint64_t[:, ::1] pc_v = pc
+        cdef uint64_t[:, ::1] tc_v = tc
+        cdef const void *xp = cnp.PyArray_DATA(x)
+        cdef const void *yp = cnp.PyArray_DATA(y)
+        cdef void *sp = cnp.PyArray_DATA(samples)
+        cdef cbool has_reset = reset_token is not None
+        cdef uint64_t reset = 0 if reset_token is None else int(reset_token)
+        if rows == 0 or cols == 0:
+            return samples, slens, pc, tc
+        with nogil:
+            self._eng.infgram_loo_sample_batch(
+                xp, yp, rows, cols, max_len, has_reset, reset, seed, sp,
+                &sl_v[0, 0], &pc_v[0, 0], &tc_v[0, 0])
+        return samples, slens, pc, tc
+
     def sample_occurrences(self, pat, uint64_t maxnum=10, uint64_t seed=0):
         """Returns ``(total_count, shard_ids, positions)``."""
         cdef cnp.ndarray a = self._as1d(pat)
