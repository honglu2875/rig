diff --git a/src/ngram/_core.pyx b/src/ngram/_core.pyx
index 737ad90..7c8d322 100644
--- a/src/ngram/_core.pyx
+++ b/src/ngram/_core.pyx
@@ -98,6 +98,13 @@ cdef extern from "facade.h" namespace "ngram" nogil:
                                       cbool has_reset, uint64_t reset_token, uint64_t seed,
                                       void *samples, uint32_t *suffix_lens, uint64_t *pc,
                                       uint64_t *tc) except +
+        void infgram_loo_sample_k_batch(const void *contexts, const void *targets,
+                                        uint64_t rows, uint64_t cols,
+                                        uint64_t num_samples, uint64_t max_len,
+                                        cbool has_reset, uint64_t reset_token,
+                                        uint64_t seed, void *samples,
+                                        uint32_t *suffix_lens, uint64_t *pc,
+                                        uint64_t *tc) except +
         void ntd_batch(const void *tokens, uint64_t rows, uint64_t cols, uint64_t max_ctx,
                        uint64_t max_support, cbool infinite, vector[int64_t] *indptr,
                        vector[uint32_t] *tokens_out, vector[uint64_t] *counts_out) except +
@@ -497,6 +504,43 @@ cdef class Engine:
                 &sl_v[0, 0], &pc_v[0, 0], &tc_v[0, 0])
         return samples, slens, pc, tc
 
+    def infgram_loo_sample_k_batch(self, contexts, targets, uint64_t num_samples,
+                                   uint64_t seed=0, uint64_t max_len=0,
+                                   reset_token=None):
+        """Sample K exact leave-one-occurrence-out targets per position.
+
+        The suffix lookup and continuation counts are shared across K i.i.d.
+        draws.  Samples have shape ``(rows, cols, num_samples)``; the other
+        three outputs retain shape ``(rows, cols)``.
+        """
+        cdef cnp.ndarray x = np.ascontiguousarray(contexts, dtype=self.dtype)
+        cdef cnp.ndarray y = np.ascontiguousarray(targets, dtype=self.dtype)
+        if num_samples == 0:
+            raise ValueError("num_samples must be positive")
+        if x.ndim != 2 or y.ndim != 2 or x.shape[0] != y.shape[0] or x.shape[1] != y.shape[1]:
+            raise ValueError("contexts and targets must be equally shaped 2-D arrays")
+        cdef uint64_t rows = x.shape[0]
+        cdef uint64_t cols = x.shape[1]
+        samples = np.empty((rows, cols, num_samples), dtype=self.dtype)
+        slens = np.zeros((rows, cols), dtype=np.uint32)
+        pc = np.zeros((rows, cols), dtype=np.uint64)
+        tc = np.zeros((rows, cols), dtype=np.uint64)
+        cdef uint32_t[:, ::1] sl_v = slens
+        cdef uint64_t[:, ::1] pc_v = pc
+        cdef uint64_t[:, ::1] tc_v = tc
+        cdef const void *xp = cnp.PyArray_DATA(x)
+        cdef const void *yp = cnp.PyArray_DATA(y)
+        cdef void *sp = cnp.PyArray_DATA(samples)
+        cdef cbool has_reset = reset_token is not None
+        cdef uint64_t reset = 0 if reset_token is None else int(reset_token)
+        if rows == 0 or cols == 0:
+            return samples, slens, pc, tc
+        with nogil:
+            self._eng.infgram_loo_sample_k_batch(
+                xp, yp, rows, cols, num_samples, max_len, has_reset, reset,
+                seed, sp, &sl_v[0, 0], &pc_v[0, 0], &tc_v[0, 0])
+        return samples, slens, pc, tc
+
     def sample_occurrences(self, pat, uint64_t maxnum=10, uint64_t seed=0):
         """Returns ``(total_count, shard_ids, positions)``."""
         cdef cnp.ndarray a = self._as1d(pat)
diff --git a/src/ngram/index.py b/src/ngram/index.py
index cdfd3aa..f1e00ac 100644
--- a/src/ngram/index.py
+++ b/src/ngram/index.py
@@ -396,6 +396,36 @@ class InfiniGram:
             x, y, seed, max_len, reset_token
         )
 
+    def infgram_loo_sample_k_batch(
+        self,
+        contexts: np.ndarray,
+        targets: np.ndarray,
+        *,
+        num_samples: int,
+        seed: int = 0,
+        max_len: int = 0,
+        reset_token: Optional[int] = None,
+    ):
+        """Sample K exact leave-one-occurrence-out targets per token.
+
+        This is the variance-reduced counterpart of
+        :meth:`infgram_loo_sample_batch`.  It performs the expensive suffix
+        lookup once per position, then draws ``num_samples`` i.i.d. targets
+        with replacement from the adjusted distribution.  Samples have shape
+        ``contexts.shape + (num_samples,)``; suffix lengths and counts retain
+        ``contexts.shape``.
+
+        For a fixed seed, the first sample is identical to the one-sample API,
+        and smaller K values are prefixes of larger K values.
+        """
+        if num_samples <= 0:
+            raise ValueError("num_samples must be positive")
+        x = np.ascontiguousarray(contexts, dtype=self.dtype)
+        y = np.ascontiguousarray(targets, dtype=self.dtype)
+        return self._engine.infgram_loo_sample_k_batch(
+            x, y, num_samples, seed, max_len, reset_token
+        )
+
