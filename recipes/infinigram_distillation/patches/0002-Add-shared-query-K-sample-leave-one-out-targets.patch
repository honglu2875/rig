diff --git a/csrc/include/engine.h b/csrc/include/engine.h
index b94b58d..b00e3ef 100644
--- a/csrc/include/engine.h
+++ b/csrc/include/engine.h
@@ -296,8 +296,8 @@ class Engine {
         });
     }
 
-    // Draw one exact next-token sample from the infinite-gram distribution at
-    // every position, after removing one occurrence of the observed
+    // Draw `num_samples` exact i.i.d. next-token samples from the infinite-gram
+    // distribution at every position, after removing one occurrence of the observed
     // continuation.  This is the leave-one-occurrence-out teacher needed when
     // the queried sequence itself belongs to the indexed corpus: without the
     // subtraction, a unique context simply retrieves its own next token.
@@ -309,10 +309,11 @@ class Engine {
     // Returned counts are after the subtraction.  If the observed
     // continuation does not occur, nothing is subtracted; this keeps the
     // primitive useful for sequences not contained in the index as well.
-    void infgram_loo_sample_batch(const T *contexts, const T *targets, U64 rows, U64 cols,
-                                  U64 max_len, bool has_reset, T reset_token, U64 seed,
-                                  T *samples, U32 *suffix_lens, U64 *prompt_cnts,
-                                  U64 *target_cnts) const {
+    void infgram_loo_sample_k_batch(const T *contexts, const T *targets, U64 rows, U64 cols,
+                                    U64 num_samples, U64 max_len, bool has_reset,
+                                    T reset_token, U64 seed, T *samples, U32 *suffix_lens,
+                                    U64 *prompt_cnts, U64 *target_cnts) const {
+        if (num_samples == 0) throw Error("num_samples must be positive");
         const size_t S = _shards.size();
         struct Segment {
             U64 row;
@@ -374,19 +375,21 @@ class Engine {
                 }
 
                 U64 state = seed ^ (0x9e3779b97f4a7c15ULL * (row * cols + t + 1));
-                T sampled;
-                for (;;) {
-                    U64 draw = splitmix64(state) % available;
-                    sampled = sample_successor(l, ranges.data(), draw);
-                    if (!excluded || sampled != truth[t]) break;
-                    // All `observed` matching continuations are exchangeable.
-                    // Reject one of them with probability 1/observed, which is
-                    // exactly equivalent to deleting the current occurrence.
-                    if (splitmix64(state) % observed != 0) break;
+                U64 idx = row * cols + t;
+                for (U64 j = 0; j < num_samples; j++) {
+                    T sampled;
+                    for (;;) {
+                        U64 draw = splitmix64(state) % available;
+                        sampled = sample_successor(l, ranges.data(), draw);
+                        if (!excluded || sampled != truth[t]) break;
+                        // All `observed` matching continuations are exchangeable.
+                        // Reject one of them with probability 1/observed, which is
+                        // exactly equivalent to deleting the current occurrence.
+                        if (splitmix64(state) % observed != 0) break;
+                    }
+                    samples[idx * num_samples + j] = sampled;
                 }
 
-                U64 idx = row * cols + t;
-                samples[idx] = sampled;
                 suffix_lens[idx] = static_cast<U32>(l);
                 prompt_cnts[idx] = available - excluded;
                 target_cnts[idx] = observed - excluded;
@@ -395,6 +398,16 @@ class Engine {
         });
     }
 
+    // Backwards-compatible one-sample convenience wrapper.
+    void infgram_loo_sample_batch(const T *contexts, const T *targets, U64 rows, U64 cols,
+                                  U64 max_len, bool has_reset, T reset_token, U64 seed,
+                                  T *samples, U32 *suffix_lens, U64 *prompt_cnts,
+                                  U64 *target_cnts) const {
+        infgram_loo_sample_k_batch(contexts, targets, rows, cols, 1, max_len, has_reset,
+                                   reset_token, seed, samples, suffix_lens, prompt_cnts,
+                                   target_cnts);
+    }
+
     // Next-token distribution at every position of every row, returned as a
     // ragged (CSR-style) structure.  `infinite` selects between a fixed context
     // window and the longest matching suffix.
