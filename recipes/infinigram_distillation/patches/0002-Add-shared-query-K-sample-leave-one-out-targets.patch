diff --git a/tests/test_correctness.py b/tests/test_correctness.py
index c2ddb83..9deef4d 100644
--- a/tests/test_correctness.py
+++ b/tests/test_correctness.py
@@ -305,6 +305,59 @@ def test_infgram_loo_sampling_frequencies_match_adjusted_distribution(
         assert empirical[token] == pytest.approx(count / total, abs=0.015)
 
 
+def test_infgram_loo_k_samples_share_lookup_and_are_nested(
+    small_index, small_corpus
+):
+    starts = [120, 430]
+    x = np.stack([small_corpus[s : s + 48] for s in starts])
+    y = np.stack([small_corpus[s + 1 : s + 49] for s in starts])
+
+    one, one_slens, one_pc, one_tc = small_index.infgram_loo_sample_batch(
+        x, y, seed=8128, max_len=5, reset_token=999
+    )
+    four, four_slens, four_pc, four_tc = small_index.infgram_loo_sample_k_batch(
+        x, y, num_samples=4, seed=8128, max_len=5, reset_token=999
+    )
+    eight = small_index.infgram_loo_sample_k_batch(
+        x, y, num_samples=8, seed=8128, max_len=5, reset_token=999
+    )[0]
+
+    assert four.shape == x.shape + (4,)
+    assert np.array_equal(four[..., 0], one)
+    assert np.array_equal(eight[..., :4], four)
+    assert np.array_equal(four_slens, one_slens)
+    assert np.array_equal(four_pc, one_pc)
+    assert np.array_equal(four_tc, one_tc)
+    with pytest.raises(ValueError, match="positive"):
+        small_index.infgram_loo_sample_k_batch(x, y, num_samples=0)
+
+
+def test_infgram_loo_k_sampling_frequencies_match_adjusted_distribution(
+    small_index, small_oracle
+):
+    context_token = 3
+    raw = small_oracle.ntd([context_token])
+    observed = max(raw, key=raw.get)
+    expected = dict(raw)
+    expected[observed] -= 1
+    if expected[observed] == 0:
+        del expected[observed]
+    total = sum(expected.values())
+
+    rows, k = 1_000, 32
+    x = np.full((rows, 1), context_token, dtype=np.uint16)
+    y = np.full((rows, 1), observed, dtype=np.uint16)
+    samples = small_index.infgram_loo_sample_k_batch(
+        x, y, num_samples=k, seed=123
+    )[0]
+
+    values, counts = np.unique(samples, return_counts=True)
+    empirical = {int(v): int(c) / (rows * k) for v, c in zip(values, counts)}
+    assert set(empirical) == set(expected)
+    for token, count in expected.items():
+        assert empirical[token] == pytest.approx(count / total, abs=0.015)
+
+
