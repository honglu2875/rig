      "storage": "one saturating int32 age per layer and stored feature"
    },
    "ghost": {
      "numerical_forward": "y_main + alpha * (g - stop_gradient(g)) = y_main",
      "input_gradient": "main path only",
      "parameter_gradients": [
        "selected dead columns of W_up",
        "selected dead entries of b_up",
        "selected dead rows of W_down"
